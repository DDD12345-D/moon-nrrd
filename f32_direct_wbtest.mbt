///| 公共读路径抽查：同一位型经 decode_data 全链路复现。
test "f32 boundary public decode path" {
  assert_true(
    decode_one_ascii_bits("1.00000005960464477539062500001") == Some(1065353217),
    msg="decode path 1.00000005960464477539062500001",
  )
  assert_true(
    decode_one_ascii_bits("1.000000059604644775390625") == Some(1065353216),
    msg="decode path 1.000000059604644775390625",
  )
  assert_true(
    decode_one_ascii_bits("1.1754943508222875e-38") == Some(8388608),
    msg="decode path 1.1754943508222875e-38",
  )
  assert_true(
    decode_one_ascii_bits("-1.1754943508222875e-38") == Some(-2139095040),
    msg="decode path -1.1754943508222875e-38",
  )
  assert_true(
    decode_one_ascii_bits("2.350988701644575e-38") == Some(16777216),
    msg="decode path 2.350988701644575e-38",
  )
  assert_true(
    decode_one_ascii_bits("-2.3509885615147287e-38") == Some(-2130706433),
    msg="decode path -2.3509885615147287e-38",
  )
}

///| Helper: decode a single ASCII float token via the public
///| read path (header parse + decode_data), returning the
///| recovered binary32 bits.
fn decode_one_ascii_bits(tok : String) -> Int? {
  try {
    let text = "NRRD0005\ntype: float\ndimension: 1\nsizes: 1\nencoding: ascii\n\n" + tok
    let data = ascii_to_bytes(text)
    let (hb, body) = split_header_body(data)
    let h = parse_header(bytes_to_ascii(hb))
    let vals = decode_data(body, h)
    Some(Float::reinterpret_as_int(Float::from_double(vals[0])))
  } catch {
    NrrdError(_) => None
  }
}
